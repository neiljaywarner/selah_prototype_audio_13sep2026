{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Selah Web (Release / API.Bible)",
      "type": "dart",
      "request": "launch",
      "toolArgs": [
        "--dart-define=API_BIBLE_KEY=${env:API_BIBLE_KEY}",
        "--dart-define=APTABASE_KEY=${env:APTABASE_KEY}",
        "--dart-define=ESV_API_KEY=${env:ESV_API_KEY}"
      ],
      "web": true
    },
    {
      "name": "Selah Android (Debug)",
      "type": "dart",
      "request": "launch",
      "toolArgs": [
        "--dart-define=API_BIBLE_KEY=${env:API_BIBLE_KEY}",
        "--dart-define=APTABASE_KEY=${env:APTABASE_KEY}",
        "--dart-define=ESV_API_KEY=${env:ESV_API_KEY}"
      ]
    },
    {
      "name": "Selah iOS (Debug)",
      "type": "dart",
      "request": "launch",
      "toolArgs": [
        "--dart-define=API_BIBLE_KEY=${env:API_BIBLE_KEY}",
        "--dart-define=APTABASE_KEY=${env:APTABASE_KEY}",
        "--dart-define=ESV_API_KEY=${env:ESV_API_KEY}"
      ]
    }
  ]
}
